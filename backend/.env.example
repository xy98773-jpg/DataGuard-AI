# DataGuard AI backend — environment configuration
# Copy to backend/.env and fill real values. All variables are optional;
# empty values fall back to built-in defaults (see app/config.py).

# ---- LLM (cloud OpenAI-compatible API; default provider) ----
# provider: fake | deepseek | openai | qwen | openai_compatible
#   fake  -> offline deterministic mode, ONLY for tests/CI/dev (never production/demo)
DG_LLM_PROVIDER=deepseek
DG_LLM_BASE_URL=https://api.deepseek.com/v1
DG_LLM_API_KEY=
DG_LLM_MODEL=deepseek-chat
# DG_LLM_TEMPERATURE=0.0
# DG_LLM_TIMEOUT_SECONDS=60
# DG_LLM_MAX_RETRIES=2

# ---- Business database ----
# Leave empty for local SQLite (dev/tests). Production example:
# DG_DATABASE_URL=postgresql+psycopg://dataguard:secret@localhost:5432/dataguard

# ---- Object storage ----
# backend: local (dev/tests) | s3 (production; needs boto3)
DG_OBJECT_STORAGE_BACKEND=local
# DG_S3_ENDPOINT_URL=http://localhost:9000
# DG_S3_BUCKET=dataguard
# DG_S3_REGION=
# DG_S3_ACCESS_KEY=
# DG_S3_SECRET_KEY=

# ---- Redis (reserved; not required in early phases) ----
# DG_REDIS_URL=redis://localhost:6379/0

# ---- Governance ----
# DG_LOW_RISK_AUTO_EXECUTE=true
# DG_MEDIUM_RISK_MODE=approval   # auto | approval
# DG_MAX_ITERATION=3

# ---- Workflow execution ----
# DG_WORKFLOW_EXECUTION_MODE=background  # background | sync
